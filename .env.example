# ==============================================
# NEW BRAND — Global Environment Configuration
# ==============================================

# Application Environment (development, staging, production)
NODE_ENV=development

# Compliance & Operational Flags
REAL_MONEY_ENABLED=false
DEFAULT_JURISDICTIONS=MX,HT
DEFAULT_LANGUAGES=es,fr

# Backend Configuration (NestJS)
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Frontend Configuration (Next.js)
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME="NEW BRAND"
NEXT_PUBLIC_REAL_MONEY_ENABLED=false

# Database Configuration (Supabase PostgreSQL / Local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/new_brand_db?schema=public

# Redis Configuration (Cache & Session)
REDIS_URL=redis://localhost:6379

# Supabase Auth / JWT Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=super-secret-jwt-key-replace-in-production

